# Supabase Configuration (Optional - for transcript storage)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Recall.ai Configuration (Required)
RECALL_API_KEY=your_recall_api_key_here

# OpenAI Configuration (Required for summarization)
OPENAI_API_KEY=your_openai_api_key_here

# AWS Configuration (Required for S3 screenshare storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=ap-south-1

# Pinecone Configuration (Required for vector search)
PINECONE_API_KEY=your_pinecone_api_key_here

# Neo4j Configuration (Required for graph database)
NEO4J_URI=your_neo4j_uri_here
NEO4J_USER=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_password_here

# Summarization Configuration (Optional - defaults provided)
SUMMARIZATION_BUFFER_MAX_ITEMS=7
SUMMARIZATION_BUFFER_MAX_SECONDS=15.0
SUMMARIZATION_MODEL=gpt-4o-mini

# Screenshare metadata table (Supabase / Postgres)
SCREENSHARE_METADATA_TABLE=screenshare_frames

# Inactivity Monitor Configuration (Optional - defaults provided)
SCOOBY_INACTIVITY_POLL_SECONDS=10
SCOOBY_NO_PARTICIPANTS_GRACE_SECONDS=120
SCOOBY_NO_TRANSCRIPTS_GRACE_SECONDS=300

# Screenshare Buffer / Redis Configuration (Optional - defaults provided)
# Redis connection URL for the in-memory screenshare frame buffer
REDIS_URL=redis://localhost:6379/0
# Maximum number of frames to retain per bot+participant buffer
SCREENSHARE_BUFFER_SIZE=100
# Time-to-live (in seconds) for each screenshare buffer key
SCREENSHARE_TTL_SECONDS=3600

# Name of the S3 bucket where screenshare frames and metadata will be stored
SCREENSHARE_S3_BUCKET=scooby-s3-screen-capture
SCREENSHARE_S3_PREFIX=screenshares/

# Public base URL for webhooks and realtime websockets (e.g. your ngrok or production URL)
PUBLIC_BASE_URL=https://your-public-base-url-here
