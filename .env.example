# Supabase Configuration (Optional - for transcript storage)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Recall.ai Configuration (Required)
RECALL_API_KEY=your_recall_api_key_here

# OpenAI Configuration (Required for summarization)
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Configuration (Required for vector search)
PINECONE_API_KEY=your_pinecone_api_key_here

# Neo4j Configuration (Required for graph database)
NEO4J_URI=your_neo4j_uri_here
NEO4J_USER=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_password_here

# Summarization Configuration (Optional - defaults provided)
SUMMARIZATION_BUFFER_MAX_ITEMS=7
SUMMARIZATION_BUFFER_MAX_SECONDS=15.0
SUMMARIZATION_MODEL=gpt-4o-mini

# Inactivity Monitor Configuration (Optional - defaults provided)
SCOOBY_INACTIVITY_POLL_SECONDS=10
SCOOBY_NO_PARTICIPANTS_GRACE_SECONDS=120
SCOOBY_NO_TRANSCRIPTS_GRACE_SECONDS=300
